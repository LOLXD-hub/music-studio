{
  "name": "music-studio",
  "productName": "Music studio",
  "version": "0.1.0",
  "description": "A DAW with its own audio engine and an MCP bridge, so an AI agent can compose, mix, listen and export music.",
  "type": "module",
  "main": "dist/main/main.cjs",
  "license": "MIT",
  "author": "Music studio contributors",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node tools/build.mjs --watch",
    "mcp": "node src/mcp/stdio.ts",
    "headless": "node src/mcp/headless.ts",
    "test": "node tests/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sfx:render": "node tools/render-sfx-library.ts",
    "media": "node tools/make-video.mjs",
    "dist": "npm run build && electron-builder --win portable",
    "docs": "node tools/make-docs.ts",
    "assets": "node tools/make-assets.ts",
    "compare": "node tools/compare-ffmpeg.ts",
    "examples": "node examples/glass-garden.mjs && node examples/night-tram.mjs && node examples/static-bloom.mjs && node examples/sfx-reel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "lamejs": "^1.2.1",
    "mpg123-decoder": "^1.0.3",
    "preact": "^10.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "dev.musicstudio.app",
    "productName": "Music studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/main/render-worker.cjs",
      "dist/mcp/stdio.cjs",
      "dist/main/lame.all.js",
      "dist/skills/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "extraMetadata": {
      "main": "dist/main/main.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOLXD-hub/music-studio.git"
  },
  "homepage": "https://github.com/LOLXD-hub/music-studio"
}
